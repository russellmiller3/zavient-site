---
// api-docs-read: static hub page — no external API/protocol surface.
// Hub listing every indexed AI-work page, industry hub, consulting guide, comparison and interactive tool.
// Updated 27 Nov 2026: indexable directory with instant client-side search and category filters so visitors
// can find the exact workflow, industry or tool in seconds instead of scanning an unfiltered 61-card wall.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ConsultingCta from '../../components/ConsultingCta.astro';
import { urlFor, TYPES } from '../../lib/page-types.mjs';
import { indexed } from '../../lib/publish.mjs';

// Reader order, who each guide is for, and a short blurb. A guide missing here still lists, after these, with its description.
const guideOrder = {
  'ai-consulting-services': { for: 'COO, head of operations, owner or CEO', blurb: 'Start here: what pays back first, and what help costs.' },
  'ai-invoice-processing': { for: 'Head of AP or finance operations', blurb: 'What AP automation costs, and what still needs a person.' },
  'account-reconciliation-automation': { for: 'Head of finance operations', blurb: 'What AI does, what auditors expect, 3 ways to build it.' },
  'ai-document-processing': { for: 'Anyone whose team re-keys documents', blurb: 'Our own accuracy test on 30 fund reports.' },
  'ai-credit-scoring': { for: 'Head of lending, credit risk', blurb: 'Fair, explainable credit models and the rules that apply.' },
  'ai-underwriting': { for: 'Head of underwriting, lenders and insurers', blurb: 'AI does the reading; the underwriter keeps the call.' },
  'generative-ai-vs-predictive-ai': { for: 'Head of lending, underwriting or planning', blurb: 'Which kind of AI fits forecasting, scoring and drafting.' },
  'rpa-vs-agentic-automation': { for: 'COO, head of operations', blurb: 'Which workflows get bots, agents, both or neither.' },
  'zapier-vs-make-vs-workato': { for: 'Head of operations, COO', blurb: 'Which automation tool fits your ops team, with dated prices.' },
  'build-vs-buy-ai': { for: 'COO, owner-CEO', blurb: 'Buy, configure or build: how to call it for each workflow.' },
  'chatgpt-vs-claude-vs-copilot-for-work': { for: 'COO, head of operations', blurb: 'Which assistant to roll out to staff, with dated prices.' },
};

const tagFor = (type) => ({
  tool: 'Free tool',
  industry: 'Industry',
  usecase: 'Workflow',
  crossing: 'Workflow',
  consulting: 'Consulting',
  compare: 'Comparison',
  role: 'Role guide',
  regulation: 'Rules',
  guide: 'Guide',
}[type] || 'Guide');

const catFor = (type) => (type === 'crossing' ? 'usecase' : (['tool', 'industry', 'usecase', 'consulting', 'compare', 'role'].includes(type) ? type : 'usecase'));

const every = await getCollection('aiwork');
// List only pages that are live (indexed); drafts and held pages stay off the hub.
const all = every.filter((p) => indexed(p, every));
const keys = Object.keys(guideOrder);
const pages = [...all.filter((p) => keys.includes(p.id)).sort((a, b) => keys.indexOf(a.id) - keys.indexOf(b.id)), ...all.filter((p) => !keys.includes(p.id))];

const counts = { all: pages.length, tool: 0, industry: 0, usecase: 0, consulting: 0, compare: 0, role: 0 };
for (const p of pages) counts[catFor(p.data.type)] = (counts[catFor(p.data.type)] || 0) + 1;

const filters = [
  { id: 'all', label: `All (${counts.all})` },
  { id: 'tool', label: `Free tools (${counts.tool})` },
  { id: 'industry', label: `Industries (${counts.industry})` },
  { id: 'usecase', label: `Workflows (${counts.usecase})` },
  { id: 'consulting', label: `Consulting (${counts.consulting})` },
  { id: 'compare', label: `Comparisons (${counts.compare})` },
];
---
<Base title="AI at work: guides, industry hubs and free tools | Zavient" description="Filter 61 researched AI guides, industry hubs, software comparisons and free interactive tools for companies of 40 to 500 people." canonical="https://zavient.com/ai-work.html" updated="2026-11-27">
  <header class="article-hero"><div class="wrap">
    <div class="label">AI work directory</div>
    <h1>AI at work, job by job</h1>
    <span class="bluf-label">Bottom line</span>
    <div class="bluf">
      <ul>
        <li>One researched guide per workflow, industry or tool decision.</li>
        <li>Each covers where AI helps, cost, rules, and buy or build.</li>
        <li>Filter below by free tools, industry, workflow or comparison.</li>
      </ul>
    </div>
    <p style="margin-top:20px;"><a class="btn-gold" href="#diagnostic">Book a free 30-minute diagnostic &rarr;</a></p>
    <p class="diag-nudge">Not sure where to start? <a href="/ai-readiness-assessment.html">Take the 3-minute readiness check</a>.</p>
  </div></header>

  <article class="article-body"><div class="wrap">
    <h2 id="directory">Browse guides and free tools</h2>
    <div class="hub-controls" id="tools">
      <label class="sr-only" for="hub-search">Search guides and tools</label>
      <input id="hub-search" class="hub-search" type="search" placeholder="Search by workflow, industry or tool (e.g. invoice, private equity, ROI)..." autocomplete="off" />
      <div class="hub-filters" role="tablist" aria-label="Filter by category">
        {filters.map((f, i) => (
          <button type="button" class={`hub-pill${i === 0 ? ' is-active' : ''}`} data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
        ))}
      </div>
      <p class="hub-status" id="hub-status" aria-live="polite">Showing all {pages.length} guides and tools.</p>
    </div>

    <div class="hub-grid" id="hub-grid">{pages.map((p) => {
      const g = guideOrder[p.id];
      const cat = catFor(p.data.type);
      const tag = tagFor(p.data.type);
      const blurb = g ? g.blurb : p.data.description;
      const searchText = `${p.data.title} ${blurb} ${tag} ${p.data.industry || ''} ${p.data.job || ''} ${g ? g.for : ''}`.toLowerCase();
      return (
        <a class="hub-card" href={urlFor(p.data, p.id)} data-cat={cat} data-search={searchText}>
          <span class="hub-tag">{tag}</span>
          <h3>{p.data.title}</h3>
          <p>{blurb}</p>
          {g && <p class="hub-for">For: {g.for}</p>}
        </a>
      );
    })}</div>
    <p class="hub-empty" id="hub-empty" hidden>No guides match that search. Try another keyword or <a href="#diagnostic">bring your workflow to the free diagnostic</a>.</p>
  </div></article>

  <script is:inline>
    (() => {
      const search = document.getElementById('hub-search');
      const pills = [...document.querySelectorAll('.hub-pill')];
      const cards = [...document.querySelectorAll('#hub-grid .hub-card')];
      const status = document.getElementById('hub-status');
      const empty = document.getElementById('hub-empty');
      if (!search || !cards.length) return;
      let active = 'all';
      const apply = () => {
        const q = search.value.trim().toLowerCase();
        let shown = 0;
        for (const c of cards) {
          const okCat = active === 'all' || c.dataset.cat === active;
          const okQ = !q || (c.dataset.search || '').includes(q);
          const show = okCat && okQ;
          c.hidden = !show;
          if (show) shown++;
        }
        status.textContent = shown === cards.length ? `Showing all ${shown} guides and tools.` : `Showing ${shown} of ${cards.length} guides and tools.`;
        empty.hidden = shown > 0;
      };
      const setFilter = (id) => {
        active = id;
        for (const p of pills) {
          const on = p.dataset.filter === id;
          p.classList.toggle('is-active', on);
          p.setAttribute('aria-pressed', String(on));
        }
        apply();
      };
      pills.forEach((p) => p.addEventListener('click', () => setFilter(p.dataset.filter)));
      search.addEventListener('input', apply);
      const hashMap = { '#tools': 'tool', '#industries': 'industry', '#workflows': 'usecase', '#consulting': 'consulting', '#comparisons': 'compare' };
      const applyHash = () => { if (hashMap[location.hash]) setFilter(hashMap[location.hash]); };
      addEventListener('hashchange', applyHash);
      applyHash();
    })();
  </script>

  <ConsultingCta job="AI in your work" />
</Base>
