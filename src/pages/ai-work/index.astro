---
// api-docs-read: static hub page — no external API/protocol surface.
// Hub listing every AI-work page.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ConsultingCta from '../../components/ConsultingCta.astro';
import { urlFor } from '../../lib/page-types.mjs';
const pages = (await getCollection('aiwork')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const stories = (await getCollection('datastory')).sort((a, b) => a.data.title.localeCompare(b.data.title));
// A title that ends in a question mark or full stop takes no colon before its description.
const sep = (title) => (/[?.!]$/.test(title) ? ' ' : ': ');
---
<Base title="AI in finance work, job by job | Zavient" description="Where AI helps finance teams, how to benchmark it before you buy, and when to buy or build. One page per job." noindex>
  <header class="article-hero"><div class="wrap">
    <div class="label">AI work</div>
    <h1>AI in finance work, job by job</h1>
    <p class="dek">One page per job: where AI helps your team, how to benchmark it on your own files before you buy, and when to buy or build.</p>
  </div></header>
  <article class="article-body"><div class="wrap">
    <h2>Guides</h2>
    <ul>{pages.map((p) => <li><a href={urlFor(p.data, p.id)}>{p.data.title}</a>{sep(p.data.title)}{p.data.description}</li>)}</ul>
    <h2>Data stories</h2>
    <p>Our own counts from recent US AI job ads, free to republish with a link back.</p>
    <ul>{stories.map((s) => <li><a href={`/data/${s.id}.html`}>{s.data.title}</a>{sep(s.data.title)}{s.data.description}</li>)}</ul>
  </div></article>
  <ConsultingCta job="AI in your finance work" />
</Base>
