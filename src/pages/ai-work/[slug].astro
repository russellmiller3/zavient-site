---
// api-docs-read: static page generator — no external API/protocol surface.
// AI-work pages one level under /ai-work/: every page built before the golden templates, and the work playbooks.
// Pages with index:true that pass the publish gate are indexed; the rest render noindex, follow. The layout lives in
// src/components/AiWorkPage.astro; other page types are built by src/pages/[...route].astro.
import AiWorkPage from '../../components/AiWorkPage.astro';
import { aiWorkRoutes, underAiWork } from '../../lib/ai-work-routes';

export async function getStaticPaths() {
  return (await aiWorkRoutes()).filter((r) => underAiWork(r.route)).map((r) => ({ params: { slug: r.route.split('/')[1] }, props: r.props }));
}
---
<AiWorkPage {...Astro.props} />
