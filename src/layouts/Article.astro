---
// api-docs-read: static article layout — no external API/protocol surface, only mailto.
// Renders one Insights article from frontmatter + Markdown body (the <slot/>),
// plus a "More from Insights" cross-link strip (related) for internal linking.
import Base from './Base.astro';
const { title, description, dek, tag, stats = [], sources = [], related = [], ctaHeading, ctaBlurb, ctaSubject } = Astro.props;
const confClass = (c) => {
  const v = (c || '').toLowerCase();
  if (v.startsWith('strong')) return 'strong';
  if (v.startsWith('med')) return 'medium';
  return 'weak';
};
---
<Base title={`${title} | Zavient`} description={description}>
  <header class="article-hero">
    <div class="wrap">
      <div class="label">{tag}</div>
      <h1>{title}</h1>
      <p class="dek">{dek}</p>
      <p class="byline">Zavient &middot; AI Value Creation for Private Equity</p>
    </div>
  </header>

  {stats.length > 0 && (
    <section class="stats">
      {stats.map((s) => (
        <div class="stat"><div class="stat-num" set:html={s.num}></div><div class="stat-label" set:html={s.label}></div></div>
      ))}
    </section>
  )}

  <article class="article-body">
    <div class="wrap">
      <slot />

      {sources.length > 0 && (
        <div class="sources">
          <h2>Sources</h2>
          <table class="sources-table">
            <thead><tr><th>Source</th><th>What it told us</th><th>Confidence</th></tr></thead>
            <tbody>
              {sources.map((src) => (
                <tr>
                  <td><a href={src.url}>{src.name}</a></td>
                  <td set:html={src.what}></td>
                  <td class={`conf ${confClass(src.conf)}`}>{src.conf}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="related">
      <div class="wrap">
        <div class="label">More from Insights</div>
        <div class="hub-grid">
          {related.map((item) => (
            <a class="hub-card" href={`/insights/${item.id}.html`}>
              <span class="hub-tag">{item.tag}</span>
              <h3>{item.title}</h3>
              <p>{item.blurb}</p>
            </a>
          ))}
        </div>
        <p class="related-all"><a href="/insights">View all insights &rarr;</a></p>
      </div>
    </section>
  )}

  <section class="article-cta">
    <div class="wrap">
      <div class="label">Start here</div>
      <h2>{ctaHeading}</h2>
      <p>{ctaBlurb}</p>
      <a class="btn-gold" href={`mailto:rmiller@zavient.com?subject=${encodeURIComponent(ctaSubject)}`}>Email rmiller@zavient.com &rarr;</a>
      <p class="cta-secondary">Or read the method note: <a href="/insights/the-pile-you-never-open.html">The pile you never open</a> &mdash; how the deals you passed on become the dataset that ranks the next ones.</p>
    </div>
  </section>
</Base>
