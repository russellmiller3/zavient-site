---
// api-docs-read: static component — no external API/protocol surface.
// One AI-work page: hero with the bottom line, the blocks in their template order, and the offer. Rendered by
// src/pages/ai-work/[slug].astro and src/pages/[...route].astro, so every page type shares one layout.
// Golden-template pages carry the free diagnostic in four spots (site architecture doc, "The shared frame"):
// under the bottom line, beside the tool or Zavient's own data, in a sticky contents box, and at the end.
// Pages built before the templates keep their layout exactly.
import Base from '../layouts/Base.astro';
import ConsultingCta from './ConsultingCta.astro';
import Fn from './Fn.astro';
import Block from './Block.astro';
import { TYPES, orderFor, headingFor, hasBlock } from '../lib/page-types.mjs';

const { page, related, spokes, isIndexed, urls, url } = Astro.props;
const d = page.data;
const t = TYPES[d.type] || TYPES.usecase;
const tpl = Boolean(d.templateVersion);
// The topic before the colon is set in the accent colour, as on Zarlent.
const [topic, ...restParts] = d.title.split(':');
const rest = restParts.join(':');
const order = orderFor(d);
// Golden-template pages that leave onPage empty get it built from their own section headings.
const onPage = d.onPage.length > 0 || !tpl ? d.onPage
  : order.filter((id) => !['what-it-is', 'resources', 'key-numbers', 'sources', 'related', 'tables'].includes(id) && hasBlock(d, id))
      .slice(0, 6).map((id) => ({ to: id === 'spokes' ? 'where-ai-pays' : id, text: headingFor(d, id) }));
// Reader-facing eyebrow (26 Nov 2026): the site is AI for all work, so pages say "AI work", not the internal type name.
// Only the free tools say what they are, because that changes what the reader does next.
const kind = tpl && d.type === 'tool' ? 'Free tool' : 'AI work';
// The page type's offer, in its reader's words (architecture doc, "The offer, by page type").
const offerLine = (t.offer || 'Get a free 30-minute diagnostic of how to approach this with AI.').replaceAll('{job}', d.job);
// Spot two sits right after the tool, or else after Zavient's own data, or else after the opening answer.
const proofAfter = tpl ? (['tool', 'own-data'].find((id) => order.includes(id) && hasBlock(d, id)) || 'what-it-is') : null;
---
<Base title={`${d.title} | Zavient`} description={d.description} noindex={!isIndexed} theme="blue" updated={d.updated}>
  <header class="article-hero">
    <div class="wrap">
      <div class="label">{kind} &middot; {d.job}{d.industry !== 'any industry' && !d.job.toLowerCase().includes(d.industry.toLowerCase()) ? ` · ${d.industry}` : ''}</div>
      <h1>{rest ? (<><span class="hl">{topic}</span>:{rest}</>) : d.title}</h1>
      {d.verdict ? (
        <div class="bluf">
          <span class="bluf-label">Bottom line</span>
          <ul>{d.verdict.map((b) => <li><Fn s={b} /></li>)}</ul>
        </div>
      ) : <p class="dek"><Fn s={d.summary} /></p>}
      {tpl && <p class="diag-nudge" data-diag="bottom-line">{offerLine}{' '}<a href="#diagnostic">Get the free 30-minute diagnostic</a></p>}
      {onPage.length > 0 && (
        <nav class="on-page" aria-label="On this page">
          <span class="bluf-label">On this page</span>
          <ol>{onPage.map((o) => <li><a href={`#${o.to}`}>{o.text}</a></li>)}</ol>
          {d.index && !tpl && <p class="on-page-cta">And at the end: <a href="#diagnostic">a free 30-minute diagnostic</a> of how to approach this with AI.</p>}
        </nav>
      )}
      <p class="byline">By <a href="/about.html" rel="author">Zavient</a> &middot; updated <time datetime={d.updated}>{d.updated}</time></p>
      {isIndexed && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, dateModified: d.updated, author: { '@type': 'Organization', name: 'Zavient', url: 'https://zavient.com/about.html' }, publisher: { '@type': 'Organization', name: 'Zavient', url: 'https://zavient.com/' }, mainEntityOfPage: `https://zavient.com${url}` })} />}
    </div>
  </header>
  <article class="article-body">
    <div class="wrap">
      {order.map((id) => (<>
        <Block id={id} d={d} page={page} related={related} spokes={spokes} urls={urls} />
        {id === proofAfter && <aside class="diag-box" data-diag="beside-proof"><p><strong>Free diagnostic:</strong>{' '}{offerLine}</p><a class="btn-gold" href="#diagnostic">Book the 30 minutes &rarr;</a></aside>}
      </>))}
    </div>
    {/* Sticky contents on every long page (Russell, 26 Nov 2026: a TOC "that stays sticky and jumplinks you on
        long pages"). The list is built in the browser from the page's own section headings, so every section is
        listed and every page type gets it with no extra data; the hero's "On this page" list is the no-script
        fallback. Rail at 1300px and wider; below that a one-row bottom bar that names the section you're in and
        opens into the full list. It sits inside the article and sticks to the bottom of the screen only while the
        article is on screen, so it can never cover the end offer or the footer (fix of 26 Nov 2026). */}
    <div class="sticky-toc is-hidden" role="navigation" aria-label="Contents" data-diag={tpl ? 'sticky' : undefined} hidden>
      <button class="toc-toggle" type="button" aria-expanded="false" aria-controls="toc-panel">
        <span class="toc-label"><span class="toc-word">Contents</span><span class="toc-count"></span></span>
        <span class="toc-now"></span>
      </button>
      <div class="toc-panel" id="toc-panel">
        <ol class="toc-list"></ol>
        <a class="toc-top" href="#top">Back to top</a>
      </div>
      <a class="btn-gold" href="#diagnostic"><span class="long">Free 30-minute diagnostic</span><span class="short">Free diagnostic</span></a>
    </div>
  </article>
  <script is:inline>
    (() => {
      const box = document.querySelector('.sticky-toc');
      const heads = [...document.querySelectorAll('.article-body h2[id]')];
      // Long pages only: five or more sections. Short pages keep just the hero list.
      if (!box || heads.length < 5) return;
      const list = box.querySelector('.toc-list');
      const now = box.querySelector('.toc-now');
      const label = box.querySelector('.toc-count');
      const toggle = box.querySelector('.toc-toggle');
      const wide = matchMedia('(min-width: 1300px)');
      const menu = document.querySelector('body > nav');
      const links = heads.map((h) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + h.id;
        a.textContent = h.textContent.trim();
        li.appendChild(a);
        list.appendChild(li);
        return a;
      });
      box.hidden = false;
      document.documentElement.classList.add('has-toc');
      // On phones and tablets the list opens from the bar, and closes after a jump, on Escape or a tap elsewhere.
      const setOpen = (open) => { box.classList.toggle('is-open', open); toggle.setAttribute('aria-expanded', String(open)); };
      toggle.addEventListener('click', () => setOpen(!box.classList.contains('is-open')));
      // A tap on a section marks it at once and holds the highlight still until the jump ends (no flicker), then
      // closes the phone list and moves focus to that heading so Tab carries on from there.
      let hold = 0;
      box.addEventListener('click', (e) => {
        const a = e.target.closest('.toc-list a');
        if (!a) { if (e.target.closest('.toc-top') && !wide.matches) setOpen(false); return; }
        const k = links.indexOf(a);
        current = -2; show(k); hold = Date.now() + 1500;
        const h = heads[k];
        if (!wide.matches) setOpen(false);
        if (h) { h.setAttribute('tabindex', '-1'); setTimeout(() => h.focus({ preventScroll: true }), 0); }
      });
      addEventListener('scrollend', () => { hold = 0; mark(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && box.classList.contains('is-open')) { setOpen(false); toggle.focus(); } });
      document.addEventListener('click', (e) => { if (!box.contains(e.target)) setOpen(false); });
      // Current section: the last heading scrolled above the reading line; at the very bottom, the last one.
      let current = -2;
      const mark = () => {
        if (Date.now() < hold) return;
        let i = -1;
        // The reading line sits 40% down the part of the screen not covered by the top menu, so the bar names a
        // section as soon as its heading reaches the upper part of what you can see (scroll-spy research, 26 Nov 2026).
        const top = menu ? Math.max(0, menu.getBoundingClientRect().bottom) : 0;
        const line = top + (innerHeight - top) * 0.4;
        heads.forEach((h, k) => { if (h.getBoundingClientRect().top <= line) i = k; });
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) i = heads.length - 1;
        show(i);
      };
      function show(i) {
        if (i === current) return;
        current = i;
        links.forEach((a, k) => (k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
        label.textContent = i >= 0 ? `${i + 1} of ${heads.length}` : `${heads.length} sections`;
        now.textContent = i >= 0 ? links[i].textContent : 'Jump to a section';
        if (i >= 0) {
          const li = links[i].parentElement, r = list.getBoundingClientRect(), b = li.getBoundingClientRect();
          if (r.height && (b.top < r.top || b.bottom > r.bottom)) list.scrollTop += b.top - r.top - r.height / 3;
        }
      }
      let ticking = false;
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { ticking = false; mark(); }); } }, { passive: true });
      addEventListener('resize', mark);
      mark();
      // Hidden while the top of the page, the end offer or the footer is on screen, so the offer never shows twice at once.
      const seen = new Set();
      const watch = [document.querySelector('.article-hero'), document.querySelector('#diagnostic'), document.querySelector('body > footer')].filter(Boolean);
      if (!('IntersectionObserver' in window) || !watch.length) { box.classList.remove('is-hidden'); return; }
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
        box.classList.toggle('is-hidden', seen.size > 0);
        if (seen.size > 0) setOpen(false);
      });
      watch.forEach((el) => io.observe(el));
    })();
  </script>
  <ConsultingCta job={d.job} heading={d.offer?.heading} ask={d.offer?.body} spot={tpl ? 'end' : ''} />
</Base>
