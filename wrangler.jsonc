// Cloudflare hosting (moved from Vercel, 26 Nov 2026). Workers Builds runs `npm run build`, then
// `npx wrangler deploy` on master and `npx wrangler preview` on other branches (a Preview URL per branch).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zavient-site",
  "compatibility_date": "2026-11-13",
  "main": "./worker/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Keep /about.html as the address; any other mode redirects it to /about.
    "html_handling": "none",
    "not_found_handling": "404-page",
    // Home page maps "/" -> "/index.html"; /api/lead and /api/t/* handle diagnostic leads and email tracking.
    "run_worker_first": ["/", "/api/lead", "/api/t/*"]
  },
  // Branch previews (`npx wrangler preview`) need this block; empty means previews use the settings above.
  "previews": {}
}
