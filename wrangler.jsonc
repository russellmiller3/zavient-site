// Cloudflare hosting (moved from Vercel, 26 Nov 2026). Workers Builds runs `npm run build`, then
// `npx wrangler deploy` on master and `npx wrangler versions upload` on other branches (preview URLs).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zavient-site",
  "compatibility_date": "2026-11-13",
  "main": "./worker/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Keep /about.html as the address; any other mode redirects it to /about.
    "html_handling": "none",
    "not_found_handling": "none",
    // Only the home page needs the script (to serve index.html for "/").
    "run_worker_first": ["/"]
  }
}
