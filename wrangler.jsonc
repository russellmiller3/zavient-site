// Cloudflare hosting (moved from Vercel, 26 Nov 2026). Workers Builds runs `npm run build`, then
// `npx wrangler deploy` on master and `npx wrangler preview` on other branches (a Preview URL per branch).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zavient-site",
  "compatibility_date": "2026-11-13",
  "main": "./worker/entry.mjs",
  "workers_dev": true,
  "preview_urls": true,
  "send_email": [
    { "name": "TRACKING_EMAIL", "destination_address": "rmiller@zavient.com" },
    { "name": "ASK_AI_EMAIL", "allowed_sender_addresses": ["tracking@alerts.zavient.com"] }
  ],
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "ASK_AI_DB", "database_name": "zavient-ask-ai", "database_id": "c0d3ceed-eaaa-418b-9247-72eaebcb859b", "migrations_dir": "ask-ai-migrations" }
  ],
  "ratelimits": [
    { "name": "ASK_AI_QUESTION_LIMIT", "namespace_id": "2026112801", "simple": { "limit": 20, "period": 60 } },
    { "name": "ASK_AI_LEAD_LIMIT", "namespace_id": "2026112802", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": {
    "ASK_AI_EMAIL_FROM": "tracking@alerts.zavient.com",
    "ASK_AI_SITE_SCOPE": "Zavient's AI consulting services, diagnostics, free tools, published workflow and industry guides, and questions about a visitor's business workflows, role or data when relevant to evaluating an AI project with Zavient. Cite or use site excerpts for claims about Zavient. Refuse unrelated requests, including entertainment, news, general coding exercises and other topics outside these boundaries. For an ambiguous question, ask how it relates to the visitor's AI project."
  },
  "kv_namespaces": [{ "binding": "TRACKING_ALERTS", "id": "2b322a33d8b8400a86c7469b466ffad5" }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Keep /about.html as the address; any other mode redirects it to /about.
    "html_handling": "none",
    "not_found_handling": "404-page",
    // Run worker first on all routes so www.zavient.com/* and /index.html 301-redirect to canonical apex URLs.
    "run_worker_first": true
  },
  // Branch previews (`npx wrangler preview`) need this block; empty means previews use the settings above.
  "previews": {}
}
