// Cloudflare hosting (moved from Vercel, 26 Nov 2026). Workers Builds runs `npm run build`, then
// `npx wrangler deploy` on master and `npx wrangler preview` on other branches (a Preview URL per branch).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zavient-site",
  "compatibility_date": "2026-11-13",
  "main": "./worker/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "send_email": [{ "name": "TRACKING_EMAIL", "destination_address": "rmiller@zavient.com" }],
  "kv_namespaces": [{ "binding": "TRACKING_ALERTS", "id": "2b322a33d8b8400a86c7469b466ffad5" }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Keep /about.html as the address; any other mode redirects it to /about.
    "html_handling": "none",
    "not_found_handling": "404-page",
    // Run worker first on all routes so www.zavient.com/* and /index.html 301-redirect to canonical apex URLs.
    "run_worker_first": true
  },
  // Branch previews (`npx wrangler preview`) need this block; empty means previews use the settings above.
  "previews": {}
}
